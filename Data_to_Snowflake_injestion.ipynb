        "# Promary connector data\n",
        "\n",
        "import snowflake.connector\n",
        "import pandas as pd\n",
        "from snowflake.connector.pandas_tools import write_pandas\n",
        "\n",
        "conn1 = snowflake.connector.connect(\n",
        "    user='xxxx',\n",
        "    password='xxxx',\n",
        "    account='xxxxx',\n",
        "    warehouse='COMPUTE_WH',\n",
        "    database='xxx',\n",
        "    schema='xxxx'\n",
        ")"
      ],
      "metadata": {
        "id": "xGZ6wunOY3Or"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "\n",
        "\n",
        "# 1 Connect to Snowflake\n",
        "\n",
        "\n",
        "conn = conn1\n",
        "\n",
        "cursor = conn.cursor()\n",
        "\n",
        "\n",
        "# 2 Full SQL Setup Script\n",
        "\n",
        "\n",
        "sql_script = \"\"\"\n",
        "DROP DATABASE IF EXISTS HOSPITAL_DB;\n",
        "\n",
        "CREATE DATABASE HOSPITAL_DB;\n",
        "USE DATABASE HOSPITAL_DB;\n",
        "\n",
        "CREATE SCHEMA CLINICAL;\n",
        "USE SCHEMA CLINICAL;\n",
        "\n",
        "CREATE TABLE HOSPITALS (\n",
        "    HOSPITAL_ID VARCHAR NOT NULL,\n",
        "    HOSPITAL_NAME VARCHAR,\n",
        "    CONSTRAINT PK_HOSPITAL PRIMARY KEY (HOSPITAL_ID)\n",
        ");\n",
        "\n",
        "CREATE TABLE WARDS (\n",
        "    WARD_ID VARCHAR NOT NULL,\n",
        "    WARD_NAME VARCHAR,\n",
        "    HOSPITAL_ID VARCHAR NOT NULL,\n",
        "    CONSTRAINT PK_WARD PRIMARY KEY (WARD_ID),\n",
        "    CONSTRAINT FK_WARD_HOSPITAL\n",
        "        FOREIGN KEY (HOSPITAL_ID)\n",
        "        REFERENCES HOSPITALS(HOSPITAL_ID)\n",
        ");\n",
        "\n",
        "CREATE TABLE PATIENTS (\n",
        "    PATIENT_ID VARCHAR NOT NULL,\n",
        "    BIRTHDATE DATE,\n",
        "    DEATHDATE DATE,\n",
        "    PREFIX VARCHAR,\n",
        "    FIRST_NAME VARCHAR,\n",
        "    MIDDLE_NAME VARCHAR,\n",
        "    LAST_NAME VARCHAR,\n",
        "    MARITAL_STATUS VARCHAR,\n",
        "    RACE VARCHAR,\n",
        "    GENDER VARCHAR,\n",
        "    ADDRESS VARCHAR,\n",
        "    CONSTRAINT PK_PATIENT PRIMARY KEY (PATIENT_ID)\n",
        ");\n",
        "\n",
        "CREATE TABLE ADMISSION_GROUPS (\n",
        "    ADMG_ID VARCHAR NOT NULL,\n",
        "    ADMISSION_GROUP_DESCRIPTION VARCHAR,\n",
        "    CONSTRAINT PK_ADMISSION_GROUP PRIMARY KEY (ADMG_ID)\n",
        ");\n",
        "\n",
        "CREATE TABLE CAUSES (\n",
        "    REASON_ID VARCHAR NOT NULL,\n",
        "    REASON_DESCRIPTION VARCHAR,\n",
        "    CONSTRAINT PK_REASON PRIMARY KEY (REASON_ID)\n",
        ");\n",
        "\n",
        "CREATE TABLE ADMISSIONS (\n",
        "    ADMISSION_ID VARCHAR NOT NULL,\n",
        "    PATIENT_ID VARCHAR NOT NULL,\n",
        "    ENCOUNTERCLASS VARCHAR,\n",
        "    DESCRIPTION VARCHAR,\n",
        "    REASON_ID VARCHAR NOT NULL,\n",
        "    ADMG_ID VARCHAR NOT NULL,\n",
        "    DELAY_DISCHARGE BOOLEAN,\n",
        "    WARD_ID VARCHAR NOT NULL,\n",
        "    ADMISSION_TIME TIMESTAMP_NTZ(9),\n",
        "    DISCHARGE_TIME TIMESTAMP_NTZ(9),\n",
        "    DISCHARGE_READY_DATETIME TIMESTAMP_NTZ(9),\n",
        "\n",
        "    CONSTRAINT PK_ADMISSION PRIMARY KEY (ADMISSION_ID),\n",
        "\n",
        "    CONSTRAINT FK_ADMISSION_PATIENT\n",
        "        FOREIGN KEY (PATIENT_ID)\n",
        "        REFERENCES PATIENTS(PATIENT_ID),\n",
        "\n",
        "    CONSTRAINT FK_ADMISSION_REASON\n",
        "        FOREIGN KEY (REASON_ID)\n",
        "        REFERENCES CAUSES(REASON_ID),\n",
        "\n",
        "    CONSTRAINT FK_ADMISSION_GROUP\n",
        "        FOREIGN KEY (ADMG_ID)\n",
        "        REFERENCES ADMISSION_GROUPS(ADMG_ID),\n",
        "\n",
        "    CONSTRAINT FK_ADMISSION_WARD\n",
        "        FOREIGN KEY (WARD_ID)\n",
        "        REFERENCES WARDS(WARD_ID)\n",
        ");\n",
        "\n",
        "ALTER TABLE ADMISSIONS\n",
        "CLUSTER BY (ADMISSION_TIME, WARD_ID);\n",
        "\"\"\"\n",
        "\n",
        "\n",
        "# 3 Execute Script\n",
        "\n",
        "\n",
        "for statement in sql_script.split(\";\"):\n",
        "    if statement.strip():\n",
        "        cursor.execute(statement)\n",
        "\n",
        "print(\" Database and tables created successfully\")\n",
        "\n",
        "\n",
        "# 6 Closing connection\n",
        "\n",
        "cursor.close()\n",
        "conn.close()\n"
