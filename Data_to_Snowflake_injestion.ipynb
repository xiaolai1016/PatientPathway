    {
      "cell_type": "code",
      "source": [
        "# Data injestion script\n",
        "\n",
        "\n",
        "# 1 Create Snowflake Connection within ne database\n",
        "def create_connection():\n",
        "    return snowflake.connector.connect(\n",
        "        user=\"xxxx",\n",
        "        password=\"xxxx\",\n",
        "        account=\"xxxx\",\n",
        "        warehouse=\"COMPUTE_WH\",\n",
        "        database=\"HOSPITAL_DB\",\n",
        "        schema=\"CLINICAL\",\n",
        "        role=\"ACCOUNTADMIN\",\n",
        "        client_session_keep_alive=True\n",
        "    )\n",
        "\n",
        "conn = create_connection()\n",
        "print(\"Snowflake connection created\")\n",
        "\n",
        "\n",
        "# 2 Read CSV Files\n",
        "hospitals_df = pd.read_csv(\"/content/hospitals.csv\")\n",
        "wards_df = pd.read_csv(\"/content/wards.csv\")\n",
        "patients_df = pd.read_csv(\"/content/patients.csv\")\n",
        "admg_df = pd.read_csv(\"/content/Admission_Groups.csv\")\n",
        "causes_df = pd.read_csv(\"/content/Causes.csv\")\n",
        "admissions_df = pd.read_csv(\"/content/Admissions.csv\")\n",
        "\n",
        "print(\"CSV files loaded\")\n",
        "\n",
        "\n",
        "# 3 Rename Columns (UPDATED FOR NEW ADMISSIONS STRUCTURE)\n",
        "\n",
        "\n",
        "hospitals_df.columns = [\"HOSPITAL_ID\", \"HOSPITAL_NAME\"]\n",
        "\n",
        "wards_df.columns = [\"WARD_ID\", \"WARD_NAME\", \"HOSPITAL_ID\"]\n",
        "\n",
        "patients_df.columns = [\n",
        "    \"PATIENT_ID\", \"BIRTHDATE\", \"DEATHDATE\",\n",
        "    \"PREFIX\", \"FIRST_NAME\", \"MIDDLE_NAME\",\n",
        "    \"LAST_NAME\", \"MARITAL_STATUS\", \"RACE\",\n",
        "    \"GENDER\", \"ADDRESS\"\n",
        "]\n",
        "\n",
        "admg_df.columns = [\"ADMG_ID\", \"ADMISSION_GROUP_DESCRIPTION\"]\n",
        "\n",
        "causes_df.columns = [\"REASON_ID\", \"REASON_DESCRIPTION\"]\n",
        "\n",
        "# NEW Admissions column structure\n",
        "admissions_df.columns = [\n",
        "    \"ADMISSION_ID\",\n",
        "    \"PATIENT_ID\",\n",
        "    \"ENCOUNTERCLASS\",\n",
        "    \"DESCRIPTION\",\n",
        "    \"REASON_ID\",\n",
        "    \"ADMG_ID\",\n",
        "    \"DELAY_DISCHARGE\",\n",
        "    \"WARD_ID\",\n",
        "    \"ADMISSION_TIME\",\n",
        "    \"DISCHARGE_TIME\",\n",
        "    \"DISCHARGE_READY_DATETIME\"\n",
        "]\n",
        "\n",
        "\n",
        "# 4 Date & Timestamp Conversion (SAFE FORMAT)\n",
        "\n",
        "\n",
        "# Patients DATE columns\n",
        "patients_df[\"BIRTHDATE\"] = pd.to_datetime(\n",
        "    patients_df[\"BIRTHDATE\"], errors=\"coerce\"\n",
        ").dt.strftime(\"%Y-%m-%d\")\n",
        "\n",
        "patients_df[\"DEATHDATE\"] = pd.to_datetime(\n",
        "    patients_df[\"DEATHDATE\"], errors=\"coerce\"\n",
        ").dt.strftime(\"%Y-%m-%d\")\n",
        "\n",
        "# Admissions TIMESTAMP columns\n",
        "admissions_df[\"ADMISSION_TIME\"] = pd.to_datetime(\n",
        "    admissions_df[\"ADMISSION_TIME\"], errors=\"coerce\"\n",
        ").dt.strftime(\"%Y-%m-%d %H:%M:%S.%f\")\n",
        "\n",
        "admissions_df[\"DISCHARGE_TIME\"] = pd.to_datetime(\n",
        "    admissions_df[\"DISCHARGE_TIME\"], errors=\"coerce\"\n",
        ").dt.strftime(\"%Y-%m-%d %H:%M:%S.%f\")\n",
        "\n",
        "admissions_df[\"DISCHARGE_READY_DATETIME\"] = pd.to_datetime(\n",
        "    admissions_df[\"DISCHARGE_READY_DATETIME\"], errors=\"coerce\"\n",
        ").dt.strftime(\"%Y-%m-%d %H:%M:%S.%f\")\n",
        "\n",
        "# Convert TRUE/FALSE safely to boolean\n",
        "admissions_df[\"DELAY_DISCHARGE\"] = admissions_df[\"DELAY_DISCHARGE\"].astype(bool)\n",
        "\n",
        "print(\"Columns aligned and formatted\")\n",
        "\n",
        "\n",
        "# 5 Safe Load Function\n",
        "\n",
        "\n",
        "def load_table(connection, df, table_name):\n",
        "    print(f\"Loading {table_name}...\")\n",
        "    success, nchunks, nrows, _ = write_pandas(connection, df, table_name)\n",
        "    if success:\n",
        "        print(f\"✔ {table_name} loaded | Rows: {nrows}\")\n",
        "    else:\n",
        "        print(f\"Failed loading {table_name}\")\n",
        "\n",
        "\n",
        "# 6 Insert Data (Correct Foreign Key  Order)\n",
        "\n",
        "\n",
        "load_table(conn, hospitals_df, \"HOSPITALS\")\n",
        "load_table(conn, wards_df, \"WARDS\")\n",
